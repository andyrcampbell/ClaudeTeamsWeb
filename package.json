{
  "name": "claude-teams-web",
  "version": "1.0.3",
  "description": "ACS AI Teams - web rewrite of the ClaudeTeams WinForms utility",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "restart": "node scripts/free-port.js && node server.js",
    "stop": "node scripts/free-port.js",
    "electron": "electron electron/main.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.acs.aiteams",
    "productName": "ACS AI Teams",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**/*",
      "Prompts/**/*",
      "scripts/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/@xterm/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/Unassigned interviewees",
        "to": "Unassigned interviewees"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
